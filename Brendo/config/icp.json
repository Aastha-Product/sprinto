{
  "_comment": "Sprinto ICP as the Evidence Map (deck slide 40). Drives extraction, the loop and qualification. Edit thresholds here, not in code.",
  "max_fetches_beyond_homepage": 4,
  "questions": [
    {
      "id": "already_certified",
      "label": "Already certified?",
      "fields": ["certifications"],
      "sources": ["/security", "/trust"],
      "sufficient": "any named certification present",
      "limit": 1,
      "if_unanswered": "treat as not certified, flag",
      "short_circuit": "disqualify_if_present"
    },
    {
      "id": "is_b2b_saas",
      "label": "B2B SaaS?",
      "fields": ["is_saas", "buyer_description"],
      "sources": ["/product", "/about"],
      "sufficient": "the description names who buys it",
      "limit": 1,
      "if_unanswered": "manual_review",
      "short_circuit": "disqualify_if_false"
    },
    {
      "id": "right_stage",
      "label": "Right stage?",
      "fields": ["funding_stage", "open_roles_count", "enterprise_customers"],
      "sources": ["/careers", "/pricing", "/customers"],
      "sufficient": "funding stage named, OR 5+ open roles, OR enterprise pricing tier",
      "limit": 2,
      "if_unanswered": "qualify at lower rank, flagged",
      "short_circuit": "none"
    }
  ],
  "stage_thresholds": {
    "min_open_roles": 5
  },

  "_ranking_comment": "Ranking signals from the brief's ICP ('typically Series A-C', 'preparing for an audit or under pressure from enterprise customers'). They set the rank and feed the hook; they never gate qualification.",
  "ranking": {
    "target_stages": ["series a", "series b", "series c"],
    "early_stages": ["pre-seed", "seed"],
    "compliance_terms": [
      "compliance manager", "compliance lead", "head of compliance", "grc",
      "security engineer", "security lead", "head of security", "ciso",
      "soc 2 in progress", "working towards soc 2", "pursuing soc 2", "soc 2 readiness",
      "security questionnaire", "security review", "vendor assessment", "audit"
    ]
  },

  "_personas_comment": "Who Sprinto sells to, best first. PoC choice takes the lowest-rank persona whose keywords match the title; ties go to Hunter's confidence. No match = no contact (flagged), never 'nearest manager'.",
  "personas": [
    {"id": "compliance_security_lead", "rank": 1,
     "keywords": ["compliance", "grc", "security", "ciso", "risk", "trust"],
     "seniority": ["head", "lead", "director", "vp", "vice president", "chief", "ciso", "manager", "officer"]},
    {"id": "engineering_leader", "rank": 2,
     "keywords": ["cto", "chief technology", "vp engineering", "vp of engineering", "head of engineering", "director of engineering"]},
    {"id": "founder_exec", "rank": 3,
     "keywords": ["founder", "co-founder", "ceo", "chief executive", "coo", "chief operating"]}
  ]
}
