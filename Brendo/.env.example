# Copy to .env and fill in. Any key left blank makes that part run in mock mode.
# With NO keys at all, the whole pipeline runs in mock mode (good for the demo/tests).

# --- LLM (Anthropic Claude; see llm.py to swap providers) ---
ANTHROPIC_API_KEY=
BRENDO_LLM_MODEL=claude-haiku-5-5          # extraction + pain points (cheap model for volume)
BRENDO_LLM_MODEL_DRAFT=claude-sonnet-5-5   # email drafting
# Prices (USD per million tokens, "input,output") used for the cost line in the report.
# Defaults are built in for the two models above; override if rates change.
# BRENDO_PRICE_CLAUDE_HAIKU_5_5=0.10,0.50
# BRENDO_PRICE_CLAUDE_SONNET_5_5=2.00,10.00

# --- Point of contact (Step 4) ---
# Option A: Hunter.io Domain Search API (free tier: 25 searches/month)
HUNTER_API_KEY=
# Option B: Apollo lookups done by hand go in inputs/contacts.csv (domain,name,role,email).
# BRENDO_CONTACTS_FILE=inputs/contacts.csv

# --- Sending (Step 7): hardcoded recipient = your own inbox ---
BRENDO_SEND_TO=you@example.com             # live sends are refused while this is a placeholder
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Behaviour ---
BRENDO_CACHE_TTL_DAYS=7
BRENDO_MAX_FETCHES=4
BRENDO_FETCH_DELAY=1.5                     # seconds between requests to the same site
