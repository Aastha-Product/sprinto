# Copy to .env and fill in. Any key left blank makes that part run in mock mode.
# With NO keys at all, the whole pipeline runs in mock mode (good for the demo/tests).
# Never commit .env (it is gitignored).

# --- LLM: Google Gemini OR Anthropic Claude (set ONE key) ---
# Gemini key from aistudio.google.com -> Get API key (starts with "AIza"):
GEMINI_API_KEY=
# Gemini models: extraction + pain points, then email drafting (both have a free tier):
BRENDO_GEMINI_MODEL=gemini-3.5-flash-lite
BRENDO_GEMINI_MODEL_DRAFT=gemini-4-hydrogen
# Tried in order when a model is overloaded, out of quota or missing (comma-separated):
BRENDO_GEMINI_FALLBACKS=gemini-3.1-flash-lite
# Or Anthropic (console.anthropic.com). If both keys are set, Anthropic is used
# unless BRENDO_LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=
# Extraction + pain points (cheap model for volume), then email drafting:
BRENDO_LLM_MODEL=claude-haiku-5-5
BRENDO_LLM_MODEL_DRAFT=claude-sonnet-5-5
# Prices (USD per million tokens, "input,output") for the cost line in the report.
# Defaults are built in for the two models above; override only if rates change.
# BRENDO_PRICE_CLAUDE_HAIKU_5_5=0.10,0.50
# BRENDO_PRICE_CLAUDE_SONNET_5_5=2.00,10.00
# BRENDO_PRICE_GEMINI_3_5_FLASH_LITE=0.30,2.50

# --- Point of contact (Step 4) ---
# Option A: Hunter.io Domain Search API (free tier: 25 searches/month)
HUNTER_API_KEY=
# Option B: Apollo lookups done by hand go in inputs/contacts.csv (domain,name,role,email).
# BRENDO_CONTACTS_FILE=inputs/contacts.csv

# --- Sending (Step 7): the ONLY recipient is your own inbox ---
# Live sends are refused while this is still the example.com placeholder.
BRENDO_SEND_TO=you@example.com
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Behaviour ---
BRENDO_CACHE_TTL_DAYS=7
BRENDO_MAX_FETCHES=4
# Seconds between requests to the same site:
BRENDO_FETCH_DELAY=1.5
